# ============================================================
#  SIXORIA SARL — Variables d'environnement
#  Copier ce fichier en .env et renseigner les vraies valeurs.
#  Ne JAMAIS committer le fichier .env sur Git.
# ============================================================

# --- Formulaire de contact (API Resend côté serveur) ---
# Configurer dans l'environnement du déploiement, sans préfixe VITE_.
# Le domaine d'expédition doit être vérifié chez Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contact@sixoria.cm

# --- WhatsApp ---
# Format international sans espaces ni + : ex. 237612345678
VITE_WHATSAPP_NUMBER=237621961547

# --- SIXORIA AI — Chatbot ---
# URL du proxy backend sécurisé (ne jamais exposer les clés API directement ici).
# En développement local : http://localhost:3001/api/chat
# En production Vercel : utiliser les Vercel Functions /api/chat
VITE_CHATBOT_API_URL=/api/chat

# La clé API du fournisseur IA est configurée UNIQUEMENT côté serveur (Vercel env ou .env serveur).
# Ne jamais la placer dans une variable VITE_ (elle serait exposée au navigateur).
# Exemple pour OpenRouter (recommandé — accès à GPT-4, Claude, Gemini, etc.) :
# OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXX

# Exemple pour OpenAI directement :
# OPENAI_API_KEY=sk-XXXXXXXXXXXX

# Modèle IA à utiliser (configurable sans modifier le code) :
# OPENROUTER_MODEL=openai/gpt-4o-mini
# ou : anthropic/claude-3-haiku, google/gemini-flash-1.5, etc.
